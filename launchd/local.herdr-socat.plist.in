<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by `make install` from launchd/local.herdr-socat.plist.in.
     Edit the template in the repo, not the installed copy. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@LABEL@</string>

    <!-- Bridges the herdr Unix socket to TCP so containers can reach it via
         host.docker.internal:@PORT@. Docker Desktop and OrbStack both forward that
         name to the host loopback, so the default bind=127.0.0.1 stays off the LAN. -->
    <key>ProgramArguments</key>
    <array>
        <string>@SOCAT@</string>
        <string>TCP-LISTEN:@PORT@,bind=@BIND@,reuseaddr,fork</string>
        <string>UNIX-CONNECT:@SOCKET@</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>@LOG@</string>
    <key>StandardErrorPath</key>
    <string>@LOG@</string>
</dict>
</plist>
